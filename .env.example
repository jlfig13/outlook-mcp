# Copie para .env e preencha. .env está no .gitignore — não versione.
# Estas variáveis também podem ir direto no claude_desktop_config.json (bloco "env").

# Application (client) ID do app registrado no Entra ID (Azure AD)
OUTLOOK_MCP_CLIENT_ID=

# "consumers" = contas pessoais @outlook/@hotmail. Não precisa mudar.
OUTLOOK_MCP_TENANT_ID=consumers

# --- Somente para o modo HTTP (server_http.py) ---
# OUTLOOK_MCP_HOST=0.0.0.0
# OUTLOOK_MCP_PORT=8787
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# OUTLOOK_MCP_AUTH_TOKEN=
# IP:porta do aparelho, protege contra DNS rebinding
# OUTLOOK_MCP_ALLOWED_HOST=192.168.1.50:8787

# Habilita as ferramentas de regras (list_rules/create_rule/delete_rule).
# Exige MailboxSettings.ReadWrite registrado no app do Entra ID e novo login.
# OUTLOOK_MCP_ENABLE_RULES=1
